{"ast":null,"code":"import SearchPanel from '@/components/SearchPanel.vue';\nimport ProductDisplay from '@/components/ProductDisplay.vue';\nimport SentimentChart from '@/components/SentimentChart.vue';\nimport TrendChart from '@/components/TrendChart.vue';\nimport ReviewsDisplay from '@/components/ReviewsDisplay.vue';\nimport SourceChart from '@/components/SourceChart.vue';\nexport default {\n  name: 'HomePage',\n  components: {\n    SearchPanel,\n    ProductDisplay,\n    SentimentChart,\n    TrendChart,\n    ReviewsDisplay,\n    SourceChart\n  }\n};","map":{"version":3,"names":["SearchPanel","ProductDisplay","SentimentChart","TrendChart","ReviewsDisplay","SourceChart","name","components"],"sources":["src/views/Home.vue"],"sourcesContent":["<template>\r\n  <div class=\"home\">\r\n    <div class=\"head\">\r\n      <h1 class=\"title\">可视化智能评论分析系统</h1>\r\n    </div>\r\n    <div class=\"content-grid\">\r\n      <div class=\"row\">\r\n        <search-panel class=\"panel\" />\r\n        <product-display class=\"panel\" />\r\n        <sentiment-chart class=\"panel\" />\r\n      </div>\r\n      <div class=\"row\">\r\n        <trend-chart class=\"panel\" />\r\n        <reviews-display class=\"panel\" />\r\n        <source-chart class=\"panel\" />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport SearchPanel from '@/components/SearchPanel.vue'\r\nimport ProductDisplay from '@/components/ProductDisplay.vue'\r\nimport SentimentChart from '@/components/SentimentChart.vue'\r\nimport TrendChart from '@/components/TrendChart.vue'\r\nimport ReviewsDisplay from '@/components/ReviewsDisplay.vue'\r\nimport SourceChart from '@/components/SourceChart.vue'\r\n\r\nexport default {\r\n  name: 'HomePage',\r\n  components: {\r\n    SearchPanel,\r\n    ProductDisplay,\r\n    SentimentChart,\r\n    TrendChart,\r\n    ReviewsDisplay,\r\n    SourceChart\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 主页样式 */\r\n.home {\r\n  padding: 20px;\r\n  min-height: 100vh;\r\n}\r\n\r\n/* 头部样式 */\r\n.head {\r\n  position: relative;\r\n  height: 80px;\r\n  background: linear-gradient(90deg, rgba(2,166,181,0.1) 0%, rgba(2,166,181,0.2) 50%, rgba(2,166,181,0.1) 100%);\r\n  margin-bottom: 30px;\r\n  border: 1px solid rgba(2,166,181,0.3);\r\n  border-radius: 4px;\r\n}\r\n\r\n/* 标题样式 */\r\n.title {\r\n  text-align: center;\r\n  color: #ffffff;\r\n  font-size: 36px;\r\n  line-height: 80px;\r\n  letter-spacing: 2px;\r\n  text-shadow: 0 0 15px rgba(2, 166, 181, 0.5);\r\n}\r\n\r\n/* 内容网格样式 */\r\n.content-grid {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n  max-width: 1800px;\r\n  margin: 0 auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n/* 行样式 */\r\n.row {\r\n  display: flex;\r\n  gap: 20px;\r\n  height: calc(50vh - 80px);\r\n  min-height: 400px;\r\n}\r\n\r\n/* 面板样式 */\r\n.panel {\r\n  flex: 1;\r\n  padding: 20px;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n/* 面板悬停效果 */\r\n.panel:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 0 25px rgba(2, 166, 181, 0.2);\r\n}\r\n\r\n/* 媒体查询，表示当浏览器的视口（viewport）宽度小于或等于1600像素时，里面定义的样式规则才会生效 */\r\n@media (max-width: 1600px) {\r\n  .content-grid {\r\n    max-width: 1400px;\r\n  }\r\n}\r\n</style> "],"mappings":"AAqBA,OAAAA,WAAA;AACA,OAAAC,cAAA;AACA,OAAAC,cAAA;AACA,OAAAC,UAAA;AACA,OAAAC,cAAA;AACA,OAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAP,WAAA;IACAC,cAAA;IACAC,cAAA;IACAC,UAAA;IACAC,cAAA;IACAC;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}